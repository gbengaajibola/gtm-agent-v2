# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Discord bot (one bot, used for both the private review post and the
# final public post — see README for how to create it) ---
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_PUBLIC_CHANNEL_ID=

# --- LLM provider for Stage 4 copy generation ---
# Default implementation calls AgentRouter's OpenAI-compatible API
# (https://agentrouter.org/v1, default model glm-5.3). Get a key at
# https://agentrouter.org/console/token. The rest of the pipeline doesn't
# care which provider is used, it only expects generate_drafts() to return text.
AGENTROUTER_API_KEY=
# Optional overrides (defaults in config.py):
# AGENTROUTER_MODEL=glm-5.3
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# --- Optional: weekly leaderboard reset day, used honestly in the copy's
# closing line. Must match reality — never invented if left blank. ---
WEEKLY_RESET_DAY=Friday
