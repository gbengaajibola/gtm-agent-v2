# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Discord bot (one bot, used for both the private review post and the
# final public post — see README for how to create it) ---
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_PUBLIC_CHANNEL_ID=

# --- LLM provider for Stage 4 copy generation ---
# Default implementation calls OpenCode Go's OpenAI-compatible API
# (https://opencode.ai/zen/go/v1, default model glm-5.3-flash). Get a key via
# the OpenCode Zen console (https://opencode.ai/auth, subscribe to Go). The rest
# of the pipeline doesn't care which provider is used, it only expects generate_drafts() to return text.
OPENCODE_GO_API_KEY=
# Optional overrides (defaults in config.py):
# OPENCODE_GO_MODEL=glm-5.3-flash
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# --- Optional: weekly leaderboard reset day, used honestly in the copy's
# closing line. Must match reality — never invented if left blank. ---
WEEKLY_RESET_DAY=Friday
